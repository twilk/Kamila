# API Configuration
API_URL=https://darwina.pl/api
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Feature Flags
ENABLE_DEBUG=false
ENABLE_LOGGING=true
ENABLE_METRICS=true

# Cache Settings
CACHE_TTL=300
CACHE_MAX_SIZE=100

# Performance
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=5000

# Security
CSP_ENABLED=true
SANITIZE_ERRORS=true
MAX_LOGIN_ATTEMPTS=3

# Metrics
METRICS_ENDPOINT=https://metrics.darwina.pl
METRICS_INTERVAL=60000

# Development
NODE_ENV=development
DEBUG_LEVEL=info 