{
    "manifest_version": 3,
    "name": "Kamila",
    "version": "1.0.0",
    "description": "Inteligentny asystent dla pracowników DARWINA.PL",
    "permissions": [
        "storage",
        "tabs",
        "windows",
        "webRequest",
        "notifications",
        "downloads",
        "scripting",
        "alarms",
        "runtime"
    ],
    "host_permissions": [
        "https://darwina.pl/*",
        "https://*.darwina.pl/*",
        "https://darwina.weblucy.com/*",
        "https://docs.google.com/*",
        "https://spreadsheets.google.com/*",
        "https://*.googleapis.com/*",
        "https://github.com/*",
        "https://raw.githubusercontent.com/*",
        "https://cdn.jsdelivr.net/*"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net; connect-src 'self' https://darwina.pl https://*.darwina.pl https://darwina.weblucy.com https://docs.google.com https://spreadsheets.google.com https://*.googleapis.com https://github.com https://raw.githubusercontent.com https://cdn.jsdelivr.net;"
    },
    "content_scripts": [{
        "matches": [
            "https://darwina.weblucy.com/raporty*"
        ],
        "js": [
            "content_scripts/userDataCollector.js"
        ],
        "type": "module"
    }],
    "web_accessible_resources": [{
        "resources": [
            "wallpapers/custom/*",
            "assets/*",
            "users/*.json",
            "config/*",
            "services/*",
            "services/core/*",
            "config/api.js",
            "qrcodes/*",
            "lib/*",
            "locales/*",
            "src/*"
        ],
        "matches": [
            "https://darwina.pl/*",
            "https://*.darwina.pl/*",
            "https://darwina.weblucy.com/*",
            "https://github.com/*"
        ]
    }],
    "minimum_chrome_version": "88"
}
